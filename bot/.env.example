# Copy this file to .env and fill it in. Never share .env publicly.

# From Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# From Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=1563355367738445884

# Right-click your server name -> Copy Server ID (Developer Mode must be on)
DISCORD_GUILD_ID=

# Role allowed to create/cancel events (role name, exactly as it appears). Leave blank = anyone with Manage Events permission.
ORGANIZER_ROLE=Event Host

# Path to the Firebase service-account JSON you download from
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json

# Public URL of the booking page on your site (shown on every event post)
SITE_URL=https://ygmackilla.github.io/electric-crew-website/bookings.html

# Channel where every event is posted (#dj-planner). Leave this line out to use the default, or set it empty to post where the command is typed.
EVENT_CHANNEL_ID=1563367054533328926
