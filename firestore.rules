rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      // Anyone (the website) can read events.
      allow read: if true;

      // Only the bot (Admin SDK, bypasses rules) creates, cancels or deletes events.
      allow create, delete: if false;

      // Website visitors may only change the `slots` field of an open, unfinished event.
      allow update: if resource.data.status == 'open'
        && request.time.toMillis() < resource.data.end
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots'])
        && request.resource.data.slots.size() == resource.data.slots.size();
    }

    // Arcade crew board: anyone can read; anyone can add one score; nobody can edit or delete from the website.
    match /arcade_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'secs', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 3000
        && request.resource.data.score % 40 == 0
        && request.resource.data.secs is int
        && request.resource.data.secs >= 5 && request.resource.data.secs <= 45
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
